{
    "name": "capelski.github.io",
    "version": "1.0.0",
    "description": "Personal page built in react",
    "scripts": {
        "build": "npm run compile && vite build",
        "compile": "tsc --noEmit -p tsconfig.json",
        "dev": "vite --open",
        "prettier": "prettier --list-different \"src/**/*.{ts,tsx}\"",
        "prettier:fix": "prettier --write \"src/**/*.{ts,tsx}\"",
        "start": "node index.js"
    },
    "author": "Carles Capellas <capellas.carles@gmail.com>",
    "license": "ISC",
    "dependencies": {
        "react": "^19.2.8",
        "react-dom": "^19.2.8",
        "react-gist": "^1.2.4",
        "react-helmet-async": "^3.0.0",
        "react-responsive": "^10.0.1",
        "react-router-dom": "^7.18.2"
    },
    "devDependencies": {
        "@types/react": "^19.2.18",
        "@types/react-dom": "^19.2.4",
        "@vitejs/plugin-react": "^5.1.0",
        "express": "^5.2.1",
        "prettier": "^3.9.6",
        "typescript": "^6.0.3",
        "vite": "^7.1.6",
        "vite-prerender-plugin": "^0.5.13"
    },
    "overrides": {
        "react-gist": {
            "react": "$react"
        }
    }
}
